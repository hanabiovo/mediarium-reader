# 复制为 .env 后填写，并 chmod 600。.env 不要提交进任何仓库。
# 随机串用 openssl rand -hex 24 生成（纯十六进制，不会弄坏数据库连接串）。

# 你的域名（不带 https://，不带结尾斜杠），例如 reader.example.com
MEDIARIUM_DOMAIN=

# Miniflux 镜像版本：填部署当天的最新稳定版号，例如 2.2.x，不要用 latest
MINIFLUX_VERSION=
# 管理员账号：第一次启动时自动建好，之后用它登录灵媒
ADMIN_USERNAME=
ADMIN_PASSWORD=
DB_PASSWORD=

# 誊写服务主密钥（openssl rand -hex 32）。设好以后不要换，换了大家存的翻译密钥都要重填
SCRIBE_SECRET=

# RSSHub 镜像版本：一个 commit SHA 标签，见 https://hub.docker.com/r/diygod/rsshub/tags
RSSHUB_VERSION=

# ——— 以下都是可选的，不用就留空 ———

# 邀请注册：用管理员账号登录 /miniflux/，在 设置 › API Keys 里新建一把，填在这里
SCRIBE_ADMIN_KEY=
# 单独的订阅地址签名密钥；留空就用 SCRIBE_SECRET
SCRIBE_FEED_KEY=
# 抓取代理，例如 http://user:pass@host:port
FETCH_PROXY=
# RSSHub 需要账号的路由（cookie），以及配了哪些（只写名字，逗号隔开）
XIAOHONGSHU_COOKIE=
INSTAGRAM_COOKIE=
HUB_CONFIGURED=
